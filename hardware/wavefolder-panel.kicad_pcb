(
  kicad_pcb (version 20231120) (generator pcbnew)
  (general (thickness 1.6) (legacy_teardrops no))
  (paper "A4")
  (title_block
    (title "Wavefolder front panel")
    (rev "A")
    (company "Lumen Rack Collective")
  )
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (34 "B.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
  )
  (setup (pad_to_mask_clearance 0.05))
  (net 0 "")
  (net 1 "GND")
  (net 2 "V+")
  (footprint "LumenRack:MountingHole_3.2mm"
    (layer "F.Cu") (at 12.5 12.5)
    (pad "" np_thru_hole circle (at 0 0) (size 3.2 3.2) (drill 3.2))
  )
  (gr_rect (start 100 100) (end 112 106) (layer "Edge.Cuts") (width 0.15))
  (gr_text "WAVEFOLDER" (at 20 4) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
)
